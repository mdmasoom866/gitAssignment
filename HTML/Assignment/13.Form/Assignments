42. Form Demonstrating All Major Override Attributes
HTML
<form action="/default_action.php" method="post" target="_self">
  <div>
    <label for="field1">Field 1 (Required):</label>
    <input type="text" id="field1" name="field1" required>
  </div>
  <br>
  <div>
    <label for="field2">Field 2 (Required):</label>
    <input type="text" id="field2" name="field2" required>
  </div>
  <br>
  <!-- Normal Submit -->
  <button type="submit">Standard Submit</button>
  
  <!-- Formaction Override -->
  <button type="submit" formaction="/override_action.php">Submit to Alternate URL</button>
  
  <!-- Formmethod Override -->
  <button type="submit" formmethod="get">Submit using GET</button>
  
  <!-- Formnovalidate Override -->
  <button type="submit" formnovalidate>Submit without Validation</button>
  
  <!-- Formtarget Override -->
  <button type="submit" formtarget="_blank">Submit to New Tab</button>
</form>
    
